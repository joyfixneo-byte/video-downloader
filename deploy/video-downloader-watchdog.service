[Unit]
# Самопроверка сайта и починка того, что зависло. Вся логика — в
# deploy/watchdog.sh, он лежит в репозитории и приезжает обычным `git pull`
# через vdup. Юнит ставится один раз и больше не трогается.
Description=Сторож video-downloader (проверка и перезапуск)
After=network-online.target

[Service]
Type=oneshot
# Без User=: перезапуск сервиса и туннеля требует root.
ExecStart=__APP_DIR__/deploy/watchdog.sh

# Внешняя проба (через VPS и frp-туннель) — выключена по умолчанию, потому что
# адрес разный на двух машинах, а файл юнита один. Раскомментируй строку СВОЕЙ
# машины — тогда сторож научится отличать «зависло приложение» от «отвалился
# туннель» и будет перезапускать frpc.
#
# ⚠️ Сначала проверь с самой VM, что адрес оттуда вообще открывается:
#   curl -s -o /dev/null -w '%{http_code}\n' -m 15 http://91.186.220.103:8002/api/config
# Должно быть 200. Если нет (egress VM не ходит на свой же внешний адрес) —
# не включай: сторож будет считать это обрывом туннеля и зря дёргать frpc.
#
# apps-vpn (порт 8000):
# Environment=WATCHDOG_PUBLIC_URL=http://91.186.220.103:8000/api/config
# apps (порт 8002):
# Environment=WATCHDOG_PUBLIC_URL=http://91.186.220.103:8002/api/config
#
# Имя юнита туннеля сторож ищет сам по маске frp*.service. Если у тебя оно
# другое или их несколько — задай явно:
# Environment=WATCHDOG_FRPC_UNIT=frpc.service
