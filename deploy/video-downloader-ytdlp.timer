[Unit]
Description=Ежедневная проверка обновлений yt-dlp

[Timer]
OnCalendar=*-*-* 04:00:00
# Обе VM ходят наружу через один канал — разводим их во времени,
# чтобы не дёргать сеть одновременно.
RandomizedDelaySec=30m
# VM была выключена в 04:00 — запустить проверку при ближайшем старте,
# а не молча пропустить сутки.
Persistent=true

[Install]
WantedBy=timers.target
